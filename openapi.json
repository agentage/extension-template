{
  "openapi": "3.1.0",
  "info": {
    "title": "template",
    "version": "0.1.0"
  },
  "components": {
    "securitySchemes": {
      "pat": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "paths": {
    "/api/v1/echo": {
      "get": {
        "operationId": "echo",
        "security": [
          {
            "pat": ["template:read"]
          }
        ],
        "parameters": [
          {
            "name": "msg",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          }
        ],
        "responses": {
          "200": {
            "description": "the envelope",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": true
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "msg": {
                          "type": "string"
                        },
                        "caller": {
                          "type": "string"
                        }
                      },
                      "required": ["msg", "caller"]
                    },
                    "meta": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {}
                    }
                  },
                  "required": ["success", "data"]
                }
              }
            }
          },
          "400": {
            "description": "VALIDATION_ERROR",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": false
                    },
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string",
                          "enum": [
                            "VALIDATION_ERROR",
                            "UNAUTHORIZED",
                            "FORBIDDEN",
                            "NOT_FOUND",
                            "CONFLICT",
                            "PRECONDITION_FAILED",
                            "PAYLOAD_TOO_LARGE",
                            "RATE_LIMITED",
                            "INTERNAL",
                            "UNAVAILABLE"
                          ]
                        },
                        "message": {
                          "type": "string",
                          "minLength": 1
                        },
                        "agcid": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9._:-]{8,128}$"
                        },
                        "details": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "field": {
                                "type": "string"
                              },
                              "message": {
                                "type": "string"
                              }
                            },
                            "required": ["field", "message"],
                            "additionalProperties": false
                          }
                        }
                      },
                      "required": ["code", "message", "agcid"],
                      "additionalProperties": false
                    }
                  },
                  "required": ["success", "error"],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/ping": {
      "get": {
        "operationId": "ping",
        "security": [],
        "responses": {
          "200": {
            "description": "the envelope",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": true
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "msg": {
                          "type": "string"
                        },
                        "pings": {
                          "anyOf": [
                            {
                              "type": "integer",
                              "minimum": -9007199254740991,
                              "maximum": 9007199254740991
                            },
                            {
                              "type": "null"
                            }
                          ]
                        }
                      },
                      "required": ["msg", "pings"]
                    },
                    "meta": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {}
                    }
                  },
                  "required": ["success", "data"]
                }
              }
            }
          }
        }
      }
    }
  }
}
